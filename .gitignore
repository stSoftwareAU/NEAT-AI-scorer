# Ignore invisible
.*
*~
!.gitignore
!.gitattributes
!.github/
!.cargo/
!.cargo/config.toml
!.gitleaks.toml
!.codespellrc
!.markdownlint.json
!.markdownlintignore
!.markdownlint-cli2.yaml



/target/
**/*.rs.bk
.DS_Store

# Belt-and-braces: bump-deps.sh + cargo upgrade can leave these
# artefacts in the worktree. Keep them ignored so a future caller
# cannot accidentally stage them (Issue #90, retained after #105
# removed the weekly workflow).
/upgrade-dry-run.txt
/upgrade.log

# NEAT-AI-core lives as a sibling clone at ../../NEAT-AI-core (see
# AGENTS.md). If a script ever checks it out inside the workspace
# as `NEAT-AI-core/` for Cargo path resolution, it must never be
# committed to this repo.
/NEAT-AI-core/
/NEAT-AI-core
